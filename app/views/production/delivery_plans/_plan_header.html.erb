<%# app/views/production/delivery_plans/_plan_header.html.erb %>
<%
  top_color = case delivery_plan.load_status
    when "all_loaded"   then "#22c55e"
    when "partial"      then "#f59e0b"
    when "some_missing" then "#ef4444"
    else "#475569"
  end
  pct_color = case delivery_plan.load_status
    when "all_loaded"   then "#4ade80"
    when "partial"      then "#fbbf24"
    when "some_missing" then "#f87171"
    else "#94a3b8"
  end
  badge_class = case delivery_plan.load_status
    when "all_loaded"   then "pd-badge--ok"
    when "partial"      then "pd-badge--partial"
    when "some_missing" then "pd-badge--missing"
    else "pd-badge--pending"
  end
  badge_label = case delivery_plan.load_status
    when "all_loaded"   then "Completo"
    when "partial"      then "En progreso"
    when "some_missing" then "Faltantes"
    else "Pendiente"
  end
  initials = delivery_plan.driver&.name&.split&.map { |w| w[0] }&.first(2)&.join&.upcase || "?"
%>
<div class="pd-header">
  <%# Fila superior: atrás + avatar + nombre + badge %>
  <div class="d-flex align-items-center gap-3 mb-3">
    <%= link_to production_delivery_plans_path(date: delivery_plan.first_delivery_date || Date.current),
        class: "pd-nav-btn text-decoration-none d-flex align-items-center justify-content-center flex-shrink-0" do %>
      <i class="bi bi-chevron-left"></i>
    <% end %>
    <div class="pd-avatar pd-avatar-lg flex-shrink-0">
      <%= initials %>
    </div>
    <div class="flex-grow-1 min-width-0">
      <div class="fw-bold text-white text-truncate pd-driver-name">
        <%= delivery_plan.driver&.name || "Sin asignar" %>
      </div>
      <div class="pd-header-subtitle">
        <i class="bi bi-truck me-1"></i><%= delivery_plan.truck_label || "N/A" %>
        &nbsp;·&nbsp;Plan #<%= delivery_plan.id %>
        &nbsp;·&nbsp;Sem. <%= delivery_plan.week %>/<%= delivery_plan.year %>
      </div>
    </div>
    <span class="pd-badge <%= badge_class %> flex-shrink-0"><%= badge_label %></span>
  </div>

  <%# Barra de progreso %>
  <div class="d-flex justify-content-between align-items-center mb-1">
    <small class="pd-header-subtitle">Progreso de carga del plan</small>
    <span class="fw-bold" style="color:<%= pct_color %>;font-size:0.95rem;"><%= delivery_plan.load_percentage %>%</span>
  </div>
  <div class="pd-progress-wrap mb-3">
    <div class="pd-progress-bar" style="width:<%= delivery_plan.load_percentage %>%;background:<%= top_color %>;"></div>
  </div>

  <%# Stats row: 4 celdas %>
  <div class="row g-2 mb-3">
    <% [["Total", load_stats[:total_items], "pd-stat-value"], ["Cargados", load_stats[:loaded_items], "pd-stat-value--ok"],
        ["Pendientes", load_stats[:unloaded_items], "pd-stat-value--warn"], ["Faltantes", load_stats[:missing_items], "pd-stat-value--error"]].each do |label, value, css| %>
      <div class="col-3">
        <div class="pd-header-stat-cell">
          <div class="fw-bold fs-6 <%= css %>"><%= value %></div>
          <div class="pd-header-stat-label"><%= label %></div>
        </div>
      </div>
    <% end %>
  </div>

  <%# Acciones del plan %>
  <div class="d-flex flex-wrap gap-2 align-items-center">
    <% if delivery_plan.load_closed? %>
      <span class="pd-badge pd-badge--ok">
        <i class="bi bi-lock-fill me-1"></i>Carga cerrada
        <%= l delivery_plan.load_closed_at, format: :short %>
        <%= "por #{delivery_plan.load_closed_by.name}" if delivery_plan.load_closed_by %>
      </span>
      <% if policy(delivery_plan).reopen_load? %>
        <%= button_to "Reabrir", reopen_load_production_delivery_plan_path(delivery_plan), method: :post,
              form: {class: "d-inline"}, class: "pd-head-btn",
              data: {turbo_confirm: "¿Reabrir la carga de este camión?"} %>
      <% end %>
    <% else %>
      <% if policy(delivery_plan).close_load? %>
        <%
          open_count = load_stats[:unloaded_items] + load_stats[:missing_items]
          confirm = open_count.zero? ? "¿Cerrar la carga del camión?" :
            "Aún hay #{load_stats[:unloaded_items]} producto(s) sin cargar y #{load_stats[:missing_items]} faltante(s). ¿Cerrar la carga de todos modos?"
        %>
        <%= button_to close_load_production_delivery_plan_path(delivery_plan), method: :post,
              form: {class: "d-inline"}, class: "pd-head-btn pd-head-btn--primary",
              data: {turbo_confirm: confirm} do %>
          <i class="bi bi-lock me-1"></i>Cerrar carga
        <% end %>
      <% end %>
      <% if policy(delivery_plan).mark_all_loaded? %>
        <%= button_to mark_all_loaded_production_delivery_plan_path(delivery_plan), method: :post,
              form: {class: "d-inline"}, class: "pd-head-btn",
              data: {turbo_confirm: "¿Marcar TODOS los productos del plan como cargados?"} do %>
          <i class="bi bi-check-all me-1"></i>Marcar todo el plan
        <% end %>
      <% end %>
    <% end %>
    <%= link_to checklist_production_delivery_plan_path(delivery_plan), target: "_blank", rel: "noopener", class: "pd-head-btn text-decoration-none" do %>
      <i class="bi bi-printer me-1"></i>Imprimir
    <% end %>
  </div>
</div>
