<%# Hoja imprimible del camión, en orden de carga %>
<style>
  @media print { nav, #navbar-container, .no-print { display: none !important; } main { margin: 0 !important; } body { background: #fff; } }
  .ck-stop { break-inside: avoid; margin-bottom: 1rem; }
  .ck-box { display: inline-block; width: 16px; height: 16px; border: 2px solid #333; border-radius: 3px; vertical-align: middle; }
</style>
<div class="container py-3">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h4 class="mb-0">Carga de camión — <%= @delivery_plan.truck_label || "N/A" %></h4>
      <div class="text-muted">
        Plan #<%= @delivery_plan.id %> · Sem. <%= @delivery_plan.week %>/<%= @delivery_plan.year %> ·
        Conductor: <%= @delivery_plan.driver&.name || "Sin asignar" %>
      </div>
      <div class="small text-muted">Orden de carga: la última parada se carga primero.</div>
    </div>
    <button type="button" class="btn btn-dark no-print" onclick="window.print()"><i class="bi bi-printer me-1"></i>Imprimir</button>
  </div>

  <% @assignments.each do |assignment| %>
    <% delivery = assignment.delivery %>
    <div class="ck-stop border rounded p-2">
      <div class="fw-bold">Parada <%= assignment.stop_order %> · <%= delivery.client&.name %> · Pedido <%= delivery.order&.number %></div>
      <div class="small text-muted mb-2"><%= delivery.delivery_address&.address %></div>
      <table class="table table-sm mb-0">
        <tbody>
          <% delivery.delivery_items.select(&:bulk_actionable?).each do |item| %>
            <tr>
              <td style="width:28px"><span class="ck-box"></span></td>
              <td><%= item.order_item&.product_name %><%= " — #{item.notes}" if item.notes.present? %></td>
              <td class="text-end" style="width:60px">&times;<%= item.quantity %></td>
            </tr>
          <% end %>
          <% if delivery.delivery_items.empty? %>
            <tr><td colspan="3" class="text-muted"><%= delivery.delivery_notes.presence || "Mandado" %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
