<%# app/views/production/delivery_plans/_load_summary.html.erb %>
<div class="px-2 py-2 pd-load-summary-bar">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <small class="fw-semibold pd-summary-title">
      <i class="bi bi-box-seam me-1"></i>Resumen de productos
    </small>
    <% if policy(delivery_plan).mark_all_loaded? %>
      <%= button_to mark_all_loaded_production_delivery_plan_path(delivery_plan),
          method: :post,
          class: "btn btn-sm fw-bold pd-mark-all-btn",
          style: "border-radius:8px;font-size:0.72rem;padding:4px 10px;",
          data: { turbo_confirm: "¿Marcar TODOS los productos del plan como cargados?" } do %>
        <i class="bi bi-check-all me-1"></i>Marcar todo
      <% end %>
    <% end %>
  </div>
  <div class="row g-2">
    <div class="col-3">
      <div class="pd-mini-stat">
        <div class="fw-bold fs-6 pd-summary-value"><%= load_stats[:total_items] %></div>
        <div class="pd-summary-sublabel">Total</div>
      </div>
    </div>
    <div class="col-3">
      <div class="pd-mini-stat">
        <div class="fw-bold fs-6 pd-summary-value--ok"><%= load_stats[:loaded_items] %></div>
        <div class="pd-summary-sublabel">Cargados</div>
      </div>
    </div>
    <div class="col-3">
      <div class="pd-mini-stat">
        <div class="fw-bold fs-6 pd-summary-value--warn"><%= load_stats[:unloaded_items] %></div>
        <div class="pd-summary-sublabel">Pendientes</div>
      </div>
    </div>
    <div class="col-3">
      <div class="pd-mini-stat">
        <div class="fw-bold fs-6" style="color:<%= load_stats[:missing_items] > 0 ? '#dc2626' : '#94a3b8' %>;">
          <%= load_stats[:missing_items] %>
        </div>
        <div class="pd-summary-sublabel">Faltantes</div>
      </div>
    </div>
  </div>
</div>
