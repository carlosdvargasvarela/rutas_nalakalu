<%# app/views/production/delivery_items/_delivery_item_row.html.erb
    locals: item, locked (carga cerrada) %>
<%
  locked      = local_assigns.fetch(:locked, false)
  active      = item.bulk_actionable?
  can_act     = active && !locked
  row_class   = {"loaded" => "pd-item-row--loaded", "missing" => "pd-item-row--missing"}[item.load_status].to_s
  note_class  = item.notes.present? ? "pd-btn-note--active" : ""
%>
<div id="delivery_item_<%= item.id %>"
     class="pd-item-row <%= row_class %>"
     data-controller="delivery-item"
     data-delivery-item-item-id-value="<%= item.id %>"
     data-delivery-item-delivery-id-value="<%= item.delivery_id %>"
     data-delivery-item-note-value="<%= item.notes.to_s %>"
     data-delivery-item-product-value="<%= item.order_item&.product_name.to_s %>"
     data-delivery-item-save-note-url-value="<%= add_note_production_delivery_item_path(item) %>">

  <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
    <div class="flex-grow-1 min-width-0">
      <div class="fw-bold pd-item-name"><%= item.order_item&.product_name || "Producto sin nombre" %></div>
      <div class="d-flex flex-wrap align-items-center gap-2 mt-1 pd-client-address">
        <span class="pd-qty">&times;<%= item.quantity %></span>
        <% if item.service_case? %>
          <span class="pd-badge pd-badge--partial"><i class="bi bi-tools me-1"></i>Caso de servicio</span>
        <% end %>
      </div>
      <div class="pd-note-preview" data-delivery-item-target="notePreview" <%= "style=display:none;".html_safe if item.notes.blank? %>>
        <% if item.notes.present? %><i class="bi bi-chat-left-text me-1"></i><%= item.notes.truncate(80) %><% end %>
      </div>
    </div>

    <% if !active %>
      <span class="pd-badge pd-badge--pending flex-shrink-0"><%= DeliveryItem::DISPLAY_STATUS_LABELS[item.status] %></span>
    <% elsif item.load_status == "loaded" %>
      <span class="pd-badge pd-badge--ok flex-shrink-0"><i class="bi bi-check-circle-fill me-1"></i>Cargado</span>
    <% elsif item.load_status == "missing" %>
      <span class="pd-badge pd-badge--missing flex-shrink-0">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>Faltante<%= " · #{item.missing_reason_label}" if item.missing_reason_label %>
      </span>
    <% end %>
  </div>

  <% if can_act && policy(item).mark_loaded? %>
    <div class="d-flex flex-wrap gap-2 pd-actions">
      <% if item.load_status == "loaded" %>
        <%= button_to mark_unloaded_production_delivery_item_path(item), method: :post,
              form: {class: "pd-act-form pd-act-form--2"}, class: "pd-btn-undo" do %>
          <i class="bi bi-arrow-counterclockwise me-1"></i>Desmarcar
        <% end %>
      <% else %>
        <%= button_to mark_loaded_production_delivery_item_path(item), method: :post,
              form: {class: "pd-act-form pd-act-form--3"}, class: "pd-btn-ok" do %>
          <i class="bi bi-check-lg me-1"></i>Cargado
        <% end %>
        <% if item.load_status == "missing" %>
          <%= button_to mark_unloaded_production_delivery_item_path(item), method: :post,
                form: {class: "pd-act-form pd-act-form--2"}, class: "pd-btn-undo" do %>
            <i class="bi bi-arrow-counterclockwise me-1"></i>Desmarcar
          <% end %>
        <% else %>
          <details class="pd-miss">
            <summary class="pd-btn-miss"><i class="bi bi-x-lg me-1"></i>Faltante</summary>
            <div class="pd-miss-menu">
              <% DeliveryItem::MISSING_REASONS.each do |key, label| %>
                <%= button_to label, mark_missing_production_delivery_item_path(item, reason: key), method: :post,
                      form: {class: "pd-act-form"}, class: "pd-btn-miss pd-btn-miss--reason" %>
              <% end %>
            </div>
          </details>
        <% end %>
      <% end %>
      <% if policy(item).add_note? %>
        <button type="button" class="pd-btn-note <%= note_class %>" aria-label="Nota"
                data-action="click->delivery-item#openNoteSheet">
          <i class="bi bi-chat-left-text"></i>
        </button>
      <% end %>
    </div>
  <% end %>
</div>
