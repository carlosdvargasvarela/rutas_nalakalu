<!DOCTYPE html>
<html>
  <head>
    <title>Tracking de Entrega | Na Lakalú</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600&family=Space+Mono&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&libraries=places"></script>
  </head>
  <body class="public-tracking-layout">
    <div class="container py-4">
      <div class="text-center mb-4">
        <%= image_tag "logo.png", alt: "Na Lakalú", class: "mb-2", style: "height: 40px; width: auto;" %>
        <p class="text-muted">Seguimiento de tu entrega</p>
      </div>
      <%= yield %>
    </div>
  </body>
</html>
