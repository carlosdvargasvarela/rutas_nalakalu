<%# app/views/sellers/index_partials/_seller_card.html.erb %>
<div id="<%= dom_id(seller, :card) %>"
     class="card shadow-sm mb-2"
     data-workspace-target="card"
     data-action="click->workspace#select">
  <%= link_to seller_path(seller),
        class: "text-decoration-none d-block text-body",
        data: { card_link: true, turbo_frame: "seller_detail" } do %>
    <div class="card-body py-2 px-3">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <div class="fw-semibold"><%= seller.name %></div>
          <div class="small text-muted"><%= seller.user&.email || "Sin usuario asignado" %></div>
        </div>
        <span class="badge text-bg-primary"><%= seller.seller_code %></span>
      </div>
    </div>
  <% end %>
</div>
