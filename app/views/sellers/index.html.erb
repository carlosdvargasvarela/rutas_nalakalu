<%# app/views/sellers/index.html.erb %>
<div class="workspace-container container-fluid py-3"
     data-controller="workspace"
     data-workspace-detail-frame-value="seller_detail"
     data-workspace-active-class="border-primary">
  <div class="row g-3 workspace-row">
    <%# ── COLUMNA IZQUIERDA: Lista ── %>
    <div class="col-12 col-lg-5 col-xl-4 workspace-col d-flex flex-column">
      <div class="card shadow-sm border-0 h-100 d-flex flex-column overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 flex-shrink-0">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2 text-primary"></i>Vendedores</h5>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#sellerFilters">
              <i class="bi bi-funnel"></i>
            </button>
          </div>
          <div id="sellerFilters" class="collapse">
            <%= search_form_for @q, url: sellers_path, method: :get, builder: SimpleForm::FormBuilder, html: { class: "row g-2 pt-2" } do |f| %>
              <div class="col-12">
                <%= f.input :name_cont, label: false, input_html: { class: "form-control-sm", placeholder: "Nombre..." } %>
              </div>
              <div class="col-12">
                <%= f.input :seller_code_cont, label: false, input_html: { class: "form-control-sm", placeholder: "Código..." } %>
              </div>
              <div class="col-12">
                <%= f.input :user_email_cont, label: false, input_html: { class: "form-control-sm", placeholder: "Correo del usuario..." } %>
              </div>
              <div class="col-12 d-flex gap-2">
                <%= f.submit "Filtrar", class: "btn btn-sm btn-primary flex-fill" %>
                <%= link_to "Limpiar", sellers_path, class: "btn btn-sm btn-outline-secondary flex-fill" %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="flex-grow-1 overflow-auto p-2 list-panel-bg">
          <% if @sellers.any? %>
            <% @sellers.each do |seller| %>
              <%= render "sellers/index_partials/seller_card", seller: seller %>
            <% end %>
            <div class="mt-3 d-flex justify-content-center">
              <%= paginate @sellers %>
            </div>
          <% else %>
            <div class="text-center py-5 bg-white rounded-3 m-2 border">
              <i class="bi bi-person-badge text-light-emphasis" style="font-size: 3rem;"></i>
              <p class="text-muted mt-3 mb-0">No hay vendedores que mostrar.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <%# ── COLUMNA DERECHA: Panel de detalle ── %>
    <div class="col-lg-7 col-xl-8 workspace-col d-none d-lg-flex flex-column">
      <div class="card shadow-sm border-0 h-100 overflow-hidden">
        <%= turbo_frame_tag "seller_detail", class: "h-100 d-block", data: { turbo_permanent: true } do %>
          <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted p-5 bg-white">
            <div class="text-center">
              <i class="bi bi-layout-sidebar-reverse text-light-emphasis" style="font-size: 4rem;"></i>
              <h5 class="fw-semibold mt-3">Selecciona un vendedor</h5>
              <p class="small text-secondary mb-0">Haz clic en uno de la lista para ver sus pedidos.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
