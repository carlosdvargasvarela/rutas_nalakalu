<%# app/views/sellers/show.html.erb %>
<div class="d-lg-none px-3 pt-3 pb-1">
  <%= link_to sellers_path, class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" do %>
    <i class="bi bi-arrow-left"></i> Volver a vendedores
  <% end %>
</div>
<%= turbo_frame_tag "seller_detail", class: "h-100 d-flex flex-column" do %>
  <%= render "sellers/show_partials/detail", seller: @seller, orders: @orders %>
<% end %>
