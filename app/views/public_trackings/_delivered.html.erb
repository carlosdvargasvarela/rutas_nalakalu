<div class="container py-4">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
          <div class="mb-4">
            <i class="bi bi-check-circle" style="font-size: 3rem; color: var(--color-success)"></i>
          </div>
          <h3 class="fw-bold mb-3">¡Tu pedido fue entregado!</h3>
          <p class="text-muted mb-4">
            Pedido <strong>#<%= @delivery.order.number %></strong> entregado en
            <strong><%= @address.address.truncate(50) %></strong>.
          </p>
        </div>
      </div>
      <div class="mt-4 text-center">
        <p class="small text-muted">Gracias por confiar en <strong>Na Lakalú</strong></p>
      </div>
    </div>
  </div>
</div>
