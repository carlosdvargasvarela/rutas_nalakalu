<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h4 mb-4">
            <i class="bi bi-upload text-primary me-2"></i> Importar Entregas
          </h1>
          <%= form_with model: @import, url: delivery_imports_path, local: true, multipart: true do |form| %>
            <div class="mb-3">
              <label for="file" class="form-label">
                Seleccionar archivo Excel/ODS
              </label>
              <%= form.file_field :file, accept: ".xlsx,.xls,.ods", required: true, class: "form-control" %>
              <div class="form-text text-muted">
                Formatos soportados: XLSX, XLS, ODS
              </div>
            </div>
            <div class="text-end">
              <%= form.submit "Subir y Procesar", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="alert alert-secondary mt-4">
        <h6 class="fw-bold">¿Cómo cargar pedidos?</h6>
        <ol class="small mb-3">
          <li>Descarga la plantilla.</li>
          <li>Llena una fila por producto (borra la fila de ejemplo). La hoja <em>Instrucciones</em> explica cada columna.</li>
          <li>Súbela aquí y revisa la vista previa antes de importar.</li>
        </ol>
        <%= link_to template_delivery_imports_path, class: "btn btn-outline-primary btn-sm" do %>
          <i class="bi bi-file-earmark-excel me-1"></i> Descargar plantilla
        <% end %>
      </div>
    </div>
  </div>
</div>