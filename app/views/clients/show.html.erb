<%# app/views/clients/show.html.erb %>
<div class="d-lg-none px-3 pt-3 pb-1">
  <%= link_to clients_path, class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" do %>
    <i class="bi bi-arrow-left"></i> Volver a clientes
  <% end %>
</div>
<%= turbo_frame_tag "client_detail", class: "h-100 d-flex flex-column" do %>
  <%= render "clients/show_partials/detail",
        client: @client,
        delivery_addresses: @delivery_addresses,
        orders: @orders %>
<% end %>
