<%# app/views/clients/index.html.erb %>
<div class="workspace-container container-fluid py-3"
     data-controller="workspace"
     data-workspace-detail-frame-value="client_detail"
     data-workspace-active-class="border-primary">
  <div class="row g-3 workspace-row">
    <%# ── COLUMNA IZQUIERDA: Lista ── %>
    <div class="col-12 col-lg-5 col-xl-4 workspace-col d-flex flex-column">
      <div class="card shadow-sm border-0 h-100 d-flex flex-column overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 flex-shrink-0">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i>Clientes</h5>
            <div class="d-flex gap-1">
              <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#clientFilters">
                <i class="bi bi-funnel"></i>
              </button>
              <% if policy(Client).create? %>
                <%= link_to new_client_path, class: "btn btn-sm btn-primary" do %>
                  <i class="bi bi-plus-lg"></i>
                  <span class="d-none d-sm-inline">Nuevo</span>
                <% end %>
              <% end %>
            </div>
          </div>
          <div id="clientFilters" class="collapse">
            <%= search_form_for @q, url: clients_path, method: :get, builder: SimpleForm::FormBuilder, html: { class: "row g-2 pt-2" } do |f| %>
              <div class="col-12">
                <%= f.input :name_cont, label: false, input_html: { class: "form-control-sm", placeholder: "Nombre..." } %>
              </div>
              <div class="col-12">
                <%= f.input :email_cont, label: false, input_html: { class: "form-control-sm", placeholder: "Correo..." } %>
              </div>
              <div class="col-12">
                <%= f.input :phone_cont, label: false, input_html: { class: "form-control-sm", placeholder: "Teléfono..." } %>
              </div>
              <div class="col-12 d-flex gap-2">
                <%= f.submit "Filtrar", class: "btn btn-sm btn-primary flex-fill" %>
                <%= link_to "Limpiar", clients_path, class: "btn btn-sm btn-outline-secondary flex-fill" %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="flex-grow-1 overflow-auto p-2 list-panel-bg">
          <% if @clients.any? %>
            <% @clients.each do |client| %>
              <%= render "clients/index_partials/client_card", client: client %>
            <% end %>
            <div class="mt-3 d-flex justify-content-center">
              <%= paginate @clients %>
            </div>
          <% else %>
            <div class="text-center py-5 bg-white rounded-3 m-2 border">
              <i class="bi bi-people text-light-emphasis" style="font-size: 3rem;"></i>
              <p class="text-muted mt-3 mb-0">No hay clientes que coincidan con los filtros.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <%# ── COLUMNA DERECHA: Panel de detalle ── %>
    <div class="col-lg-7 col-xl-8 workspace-col d-none d-lg-flex flex-column">
      <div class="card shadow-sm border-0 h-100 overflow-hidden">
        <%= turbo_frame_tag "client_detail", class: "h-100 d-block", data: { turbo_permanent: true } do %>
          <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted p-5 bg-white">
            <div class="text-center">
              <i class="bi bi-layout-sidebar-reverse text-light-emphasis" style="font-size: 4rem;"></i>
              <h5 class="fw-semibold mt-3">Selecciona un cliente</h5>
              <p class="small text-secondary mb-0">Haz clic en uno de la lista para ver sus datos, direcciones y pedidos.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
