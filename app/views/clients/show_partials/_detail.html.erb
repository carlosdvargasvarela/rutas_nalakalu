<%# app/views/clients/show_partials/_detail.html.erb %>
<div class="h-100 overflow-auto bg-white p-4">
  <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
      <i class="bi bi-person-circle fs-2 text-primary me-3"></i>
      <div>
        <h1 class="h4 mb-0"><%= client.name %></h1>
        <p class="text-muted small mb-0">Creado el <%= l(client.created_at, format: :short) %></p>
      </div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1"
              data-bs-toggle="modal"
              data-bs-target="#clientNotesModal_<%= client.id %>">
        <i class="bi bi-sticky-fill"></i>
        <span id="client_notes_badge_<%= client.id %>">
          <%= render "client_notes/badge", client: client %>
        </span>
        <span class="small">Notas</span>
      </button>
      <% if policy(client).update? %>
        <%= link_to raw('<i class="bi bi-pencil"></i> Editar'), edit_client_path(client),
            class: "btn btn-sm btn-outline-secondary", data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  </div>

  <% if client.pinned_notes.any? %>
    <div class="mb-3">
      <div class="d-flex align-items-center gap-2 mb-2">
        <i class="bi bi-pin-angle-fill text-warning"></i>
        <span class="fw-semibold small text-muted">Alertas del cliente</span>
      </div>
      <%= render "client_notes/pinned_banner", client: client %>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-lg-5">
      <div class="card mb-3">
        <div class="card-header bg-light fw-semibold">Información</div>
        <div class="card-body">
          <p class="mb-1"><i class="bi bi-telephone me-2 text-muted"></i><%= client.phone.presence || "Sin teléfono" %></p>
          <p class="mb-0"><i class="bi bi-envelope me-2 text-muted"></i><%= client.email.presence || "Sin correo" %></p>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header bg-light fw-semibold">Direcciones de entrega</div>
        <div class="card-body">
          <% if delivery_addresses.any? %>
            <div class="row row-cols-1 g-2">
              <% delivery_addresses.each do |addr| %>
                <div class="col">
                  <div class="border rounded p-2">
                    <div class="fw-semibold small"><%= addr.address %></div>
                    <div class="text-muted"><small><%= addr.description.presence || "Sin descripción" %></small></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-geo-alt fs-3 d-block mb-2"></i>
              No hay direcciones registradas.
            </div>
          <% end %>
        </div>
      </div>

      <% if policy(client).destroy? %>
        <%= link_to raw('<i class="bi bi-trash"></i> Eliminar cliente'), client_path(client),
            data: { turbo_method: :delete, turbo_frame: "_top", turbo_confirm: "¿Seguro que deseas eliminar este cliente?" },
            class: "btn btn-outline-danger w-100" %>
      <% end %>
    </div>

    <div class="col-lg-7">
      <div class="card">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Pedidos recientes</span>
          <%= link_to "Ver todos", orders_path(q: { client_id_eq: client.id }),
              class: "btn btn-sm btn-outline-primary", data: { turbo_frame: "_top" } %>
        </div>
        <div class="card-body p-0">
          <% if orders.any? %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Número</th>
                    <th>Vendedor</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.each do |order| %>
                    <tr>
                      <td><%= link_to order.number, order_path(order), class: "link-primary", data: { turbo_frame: "_top" } %></td>
                      <td><%= order.seller.name %> (<%= order.seller.seller_code %>)</td>
                      <td><span class="badge text-bg-secondary"><%= order.status.humanize %></span></td>
                      <td><%= l(order.created_at, format: :short) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <div class="p-2 d-flex justify-content-center">
              <%= paginate orders, param_name: :orders_page %>
            </div>
          <% else %>
            <div class="p-4 text-center text-muted">
              <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
              Sin pedidos registrados.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<%= render "client_notes/modal", client: client %>
