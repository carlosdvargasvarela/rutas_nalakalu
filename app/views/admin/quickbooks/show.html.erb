<div class="container mt-4 admin-container-md">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Dashboard", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "Admin", admin_users_path %></li>
      <li class="breadcrumb-item active">QuickBooks</li>
    </ol>
  </nav>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
      <h5 class="mb-0 fw-semibold">
        <i class="bi bi-arrow-repeat me-2 text-primary"></i>Sincronización QuickBooks
      </h5>
    </div>
    <div class="card-body p-4">

      <% if notice.present? %>
        <div class="alert alert-success border-0 shadow-sm mb-4">
          <i class="bi bi-check-circle-fill me-2"></i><%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger border-0 shadow-sm mb-4">
          <i class="bi bi-exclamation-triangle-fill me-2"></i><%= alert %>
        </div>
      <% end %>

      <p class="text-muted mb-4">
        Configura desde qué fecha QuickBooks buscará órdenes de venta modificadas en la próxima sincronización.
      </p>

      <% current_value = AppSetting.get("qb_sync_from_date") %>
      <% display_date = current_value.present? ? current_value.split("T").first : nil %>

      <div class="mb-4 p-3 rounded qb-current-date-box">
        <p class="mb-1 small text-muted fw-semibold">Fecha activa actualmente:</p>
        <% if display_date.present? %>
          <span class="fw-semibold"><i class="bi bi-calendar-check me-1 text-success"></i><%= display_date %></span>
        <% else %>
          <span class="text-muted fst-italic">No configurada — usa el día de ayer por defecto</span>
        <% end %>
      </div>

      <%= form_with url: admin_quickbooks_path, method: :patch, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label fw-semibold" for="from_date">Nueva fecha de inicio</label>
          <input type="date"
                 id="from_date"
                 name="from_date"
                 class="form-control qb-date-input"
                 value="<%= display_date %>"
                 max="<%= Date.today.strftime('%Y-%m-%d') %>">
          <div class="form-text">QB buscará órdenes modificadas a partir de esta fecha.</div>
        </div>
        <button type="submit" class="btn btn-primary px-4">
          <i class="bi bi-save me-2"></i>Guardar fecha
        </button>
      <% end %>


      <% if @standby_orders.any? %>
        <hr class="my-4">
        <h6 class="fw-semibold"><i class="bi bi-pause-circle me-2 text-warning"></i>Pedidos en stand-by (<%= @standby_orders.size %>)</h6>
        <p class="text-muted small">Guardados completos, pero no aparecen en rutas ni listados hasta liberarlos. Para liberar, confirme o corrija el número.</p>
        <table class="table table-sm align-middle">
          <thead><tr><th>Cliente</th><th>Motivo</th><th>Número</th><th></th></tr></thead>
          <tbody>
            <% @standby_orders.each do |o| %>
              <tr>
                <td><%= link_to o.client.name, order_path(o) %><br><%= link_to "Editar dirección y productos", admin_edit_standby_quickbooks_path(o), class: "small" %></td>
                <td class="small"><%= o.qb_standby_reason %></td>
                <td colspan="2">
                  <%= form_with url: admin_release_quickbooks_standby_path(o), method: :post, class: "d-flex gap-2" do %>
                    <input type="text" name="number" value="<%= o.number %>" class="form-control form-control-sm">
                    <button type="submit" class="btn btn-sm btn-outline-success" data-turbo-confirm="¿Liberar este pedido? Pasará a ser utilizable.">Liberar</button>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <% if @standby.any? %>
        <hr class="my-4">
        <h6 class="fw-semibold"><i class="bi bi-pause-circle me-2 text-warning"></i>Pedidos con error, sin cargar (<%= @standby.size %>)</h6>
        <p class="text-muted small">QuickBooks los envió pero no se pudieron cargar (error al procesar); se conserva el contenido recibido.</p>
        <table class="table table-sm">
          <thead><tr><th>Pedido</th><th>Cliente QB</th><th>Motivo</th><th>Recibido</th></tr></thead>
          <tbody>
            <% @standby.each do |s| %>
              <tr>
                <td class="fw-semibold"><%= s.order_number %></td>
                <td><%= s.payload.dig("customer_ref", "full_name") %></td>
                <td class="small"><%= s.reason %></td>
                <td class="small"><%= l s.created_at, format: :short %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>
