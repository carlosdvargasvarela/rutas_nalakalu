<%# app/views/deliveries/order_number_form.html.erb %>
<%= turbo_frame_tag "modal" do %>
  <div class="modal-header">
    <h5 class="modal-title fw-semibold">
      <i class="bi bi-hash me-2"></i>Editar número de pedido
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
  </div>
  <div class="modal-body">
    <%= form_with url: update_order_number_delivery_path(@delivery), method: :patch, local: true, data: { turbo_frame: "_top" } do |f| %>
      <div class="mb-3">
        <label class="form-label fw-semibold small">Número de pedido</label>
        <%= f.text_field :number, value: @delivery.order.number, required: true, class: "form-control form-control-sm" %>
        <div class="form-text">Cambia el número en el pedido y en todas sus entregas.</div>
      </div>
      <div class="modal-footer px-0 pb-0">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <%= f.submit "Guardar", class: "btn btn-sm btn-primary fw-semibold",
              data: { disable_with: "Guardando...", turbo_confirm: "¿Cambiar el número de pedido?" } %>
      </div>
    <% end %>
  </div>
<% end %>
