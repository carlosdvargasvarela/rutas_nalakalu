<div class="card shadow-sm mb-4">
  <div class="card-header bg-light">
    <i class="bi bi-person-badge me-2 text-success"></i><strong>Responsable del mandado</strong>
  </div>
  <div class="card-body">
    <div class="alert alert-info mb-3">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Información del responsable:</strong> Persona que recibirá o coordinará el mandado en destino
    </div>
    <div class="mb-3 d-none" data-vendor-address-select-target="contactChips">
      <label class="form-label fw-bold small text-muted mb-1">
        <i class="bi bi-person-lines-fill me-1"></i>Contactos del proveedor — clic para usar uno
      </label>
      <div class="d-flex flex-wrap gap-2" data-vendor-address-select-target="contactChipsList"></div>
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :contact_name,
            label: "Nombre completo",
            input_html: {
              class: "form-control form-control-lg",
              placeholder: "Ej: Juan Pérez",
              data: {
                action: "input->internal-delivery-form#validateResponsible",
                "vendor-address-select-target": "contactName"
              }
            },
            label_html: { class: "form-label fw-bold" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :contact_phone,
            label: "Teléfono de contacto",
            input_html: {
              class: "form-control form-control-lg",
              placeholder: "8888-8888",
              data: {
                action: "input->internal-delivery-form#validateResponsible",
                "vendor-address-select-target": "contactPhone"
              }
            },
            label_html: { class: "form-label fw-bold" } %>
      </div>
    </div>
  </div>
</div>