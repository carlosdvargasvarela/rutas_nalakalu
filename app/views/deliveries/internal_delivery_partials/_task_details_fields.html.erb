<% unless current_user.admin? %>
<div class="card shadow-sm mb-4">
  <div class="card-header bg-light">
    <i class="bi bi-box-seam me-2 text-success"></i><strong>Productos</strong>
  </div>
  <div class="card-body" data-controller="nested-form">
    <p class="small text-muted"><i class="bi bi-info-circle me-1"></i>Agrega un producto por línea.</p>
    <% row = capture do %>
      <div class="input-group mb-2" data-nested-form-target="item">
        <input type="number" name="delivery[delivery_items_attributes][__IDX__][order_item_attributes][quantity]"
               class="form-control flex-grow-0" style="width: 6rem" value="1" min="1" step="1" required aria-label="Cantidad">
        <input type="text" name="delivery[delivery_items_attributes][__IDX__][order_item_attributes][product]"
               class="form-control" placeholder="Ej: 10 cajas de tornillos 2&quot;" __REQ__>
        <button type="button" class="btn btn-outline-danger" data-action="nested-form#remove" aria-label="Quitar producto">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    <% end %>
    <div data-nested-form-target="list" data-action="input->internal-delivery-form#validateTaskDetails">
      <%= row.sub("__IDX__", "0").sub("__REQ__", "required").html_safe %>
    </div>
    <template data-nested-form-target="template"><%= row.sub("__IDX__", "NEW_RECORD").sub("__REQ__", "").html_safe %></template>
    <button type="button" class="btn btn-outline-success btn-sm" data-action="nested-form#add">
      <i class="bi bi-plus-lg me-1"></i>Agregar producto
    </button>
  </div>
</div>
<% else %>
<div class="card shadow-sm mb-4">
  <div class="card-header bg-light">
    <i class="bi bi-pencil-square me-2 text-success"></i><strong>Detalle del mandado</strong>
  </div>
  <div class="card-body">

    <%# Productos físicos (si aplica) %>
    <div class="mb-4">
      <div class="form-label fw-bold fs-6">
        <i class="bi bi-box-seam me-1 text-success"></i>
        Productos
        <span class="badge bg-light text-secondary border ms-1" style="font-weight:400;">Opcional</span>
      </div>
      <p class="small text-muted mb-3">
        <i class="bi bi-info-circle me-1"></i>
        Si el mandado implica llevar o recoger productos específicos, descríbelos aquí.
        Dejar en blanco si no aplica.
      </p>
      <%= f.simple_fields_for :delivery_items do |di| %>
        <%= di.simple_fields_for :order_item do |oi| %>
          <%= oi.input :product,
              as: :text,
              label: "Lista de productos",
              input_html: {
                class: "form-control",
                rows: 3,
                placeholder: "Ej: 10 cajas de tornillos 2\", 5 rollos de cinta de embalaje..."
              },
              hint: "Un producto por línea o una descripción general",
              label_html: { class: "form-label fw-bold" } %>
          <%= oi.hidden_field :quantity, value: 1 %>
          <%= di.hidden_field :quantity_delivered, value: 1 %>
        <% end %>
      <% end %>
    </div>

    <%# ¿Qué hay que hacer? (opcional) %>
    <div class="border-top pt-3">
      <%= f.label :delivery_notes, class: "form-label fw-bold fs-6" do %>
        <i class="bi bi-clipboard-check me-1 text-success"></i>
        ¿Qué hay que hacer?
        <span class="badge bg-light text-secondary border ms-1" style="font-weight:400;">Opcional</span>
      <% end %>
      <%= f.text_area :delivery_notes,
          class: "form-control",
          rows: 5,
          placeholder: "Ej: Recoger 50 tornillos de 2 pulgadas en Ferretería El Tornillo y llevarlos a la bodega principal. Pedir factura a nombre de NaLakalu.",
          data: {
            action: "input->internal-delivery-form#validateTaskDetails"
          } %>
      <div class="form-text">
        <i class="bi bi-info-circle me-1"></i>
        Sea lo más específico posible para evitar confusiones al chofer
      </div>
    </div>

    <%# Ejemplos de mandados comunes %>
    <div class="card bg-light border-0 mt-3">
      <div class="card-body py-2">
        <h6 class="text-muted mb-2 small">
          <i class="bi bi-lightbulb me-1"></i> Ejemplos de mandados comunes:
        </h6>
        <ul class="small mb-0 text-muted">
          <li>Trasladar 10 cajas de herrajes desde bodega A a bodega B</li>
          <li>Comprar materiales en ferretería según lista adjunta</li>
          <li>Recoger documentos firmados en oficinas del cliente X</li>
          <li>Entregar muestras de productos a vendedor en zona Y</li>
        </ul>
      </div>
    </div>

  </div>
</div>

<% end %>
