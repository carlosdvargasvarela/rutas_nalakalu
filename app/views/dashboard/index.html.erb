<!-- app/views/dashboard/index.html.erb -->
<div class="container-fluid py-4">
  <!-- Header con Saludo y Acciones Rápidas -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1 text-dark">
        <i class="bi bi-speedometer2 me-2 text-primary"></i>
        Panel de Control
      </h2>
      <p class="text-muted mb-0">
        Hola, <strong><%= current_user.name %></strong>.
        Aquí tienes el resumen de logística para hoy.
      </p>
    </div>
    <div class="d-flex gap-2">
      <% if current_user.admin? || current_user.production_manager? %>
        <%= link_to new_internal_delivery_deliveries_path, class: "btn btn-success rounded-pill shadow-sm" do %>
          <i class="bi bi-plus-lg me-1"></i> Nuevo Mandado
        <% end %>
        <%= link_to new_delivery_import_path, class: "btn btn-outline-primary rounded-pill shadow-sm" do %>
          <i class="bi bi-file-earmark-excel me-1"></i> Importar
        <% end %>
      <% end %>
      <% if current_user.seller? || current_user.admin? %>
        <%= link_to orders_path, class: "btn btn-primary rounded-pill shadow-sm" do %>
          <i class="bi bi-plus-lg me-1"></i> Nuevo Pedido
        <% end %>
      <% end %>
      <%= link_to notifications_path, class: "btn btn-outline-info rounded-pill shadow-sm position-relative" do %>
        <i class="bi bi-bell"></i>
        <% if @unread_notifications_count > 0 %>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            <%= @unread_notifications_count %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render "dashboard/today_stats",
        today_stats: @today_stats,
        active_orders_count: @active_orders_count,
        unread_notifications_count: @unread_notifications_count,
        unplanned_count: @unplanned_this_week.total_count %>

  <%= render "dashboard/data_quality", issues: @data_quality_issues %>

  <div class="row g-4">
    <!-- Columna Izquierda: Colas de trabajo -->
    <div class="col-lg-8">
      <%= render "dashboard/attention_queue", items: @attention_queue, active_category: params[:category] %>

      <div class="card border-0 shadow-sm rounded-4" id="unplanned">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="mb-0 fw-bold">
            <i class="bi bi-calendar-x text-warning me-1"></i> Sin plan (esta semana)
            <span class="badge bg-light text-dark ms-1"><%= @unplanned_this_week.total_count %></span>
          </h5>
        </div>
        <div class="card-body p-0">
          <%= render "dashboard/table_unplanned", deliveries: @unplanned_this_week %>
        </div>
      </div>
    </div>
    <!-- Columna Derecha: Tareas y Notificaciones -->
    <div class="col-lg-4">
      <div class="mb-4">
        <%= render "dashboard/pending_tasks", tasks: @pending_tasks %>
      </div>
      <div>
        <%= render "dashboard/recent_notifications", notifications: @recent_notifications %>
      </div>
    </div>
  </div>
  <!-- Soporte -->
  <div class="alert alert-info mt-5 rounded-3 d-flex align-items-center shadow-sm">
    <i class="bi bi-question-circle-fill fs-4 me-2"></i>
    <span>
      ¿Necesitas ayuda?
      <a href="mailto:cvargas@nalakalu.com" class="fw-semibold ms-1">Contacta al equipo de soporte</a>
    </span>
  </div>
</div>
